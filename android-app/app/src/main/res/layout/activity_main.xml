<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bu_bg">

    <!-- Header: live count + link status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/bu_bg">

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/bu_pink"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/counted_today"
                android:textColor="@color/bu_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_linked"
                android:textColor="@color/bu_pink_soft"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:background="@color/bu_bg">

        <Button
            android:id="@+id/voteBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vote"
            android:textColor="@color/bu_bg"
            android:textSize="12sp"
            android:background="@drawable/btn_pink" />

        <Button
            android:id="@+id/linkBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/link"
            android:textColor="@color/bu_pink"
            android:textSize="12sp"
            android:background="@drawable/btn_ghost" />

        <Button
            android:id="@+id/boardBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/board"
            android:textColor="@color/bu_pink"
            android:textSize="12sp"
            android:background="@drawable/btn_ghost" />
    </LinearLayout>

    <!-- Voting accounts roster (email used + how many of the 2 categories it covered) -->
    <TextView
        android:id="@+id/acctToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#1A0A12"
        android:textColor="@color/bu_pink_soft"
        android:textSize="12sp"
        android:text="@string/accounts_collapsed" />

    <ScrollView
        android:id="@+id/acctScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="180dp"
        android:visibility="gone"
        android:background="#12000A">

        <LinearLayout
            android:id="@+id/acctList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp" />
    </ScrollView>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
