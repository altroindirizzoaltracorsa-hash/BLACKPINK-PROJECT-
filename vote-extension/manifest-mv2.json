{
  "manifest_version": 2,
  "name": "Blinks United — Vote Counter",
  "version": "1.7.0",
  "description": "Counts the BLACKPINK & members votes you cast on the MTV VMA and BreakTudo Awards sites and logs them to your blinksunited.com voting board.",
  "permissions": [
    "storage",
    "webRequest",
    "https://vote.mtv.com/*",
    "https://vote.breaktudoawards.com/*",
    "https://blinksunited.com/*",
    "https://*.blinksunited.com/*"
  ],
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": { "default_popup": "popup.html", "default_title": "BU Vote Counter" },
  "content_scripts": [
    {
      "matches": ["https://vote.mtv.com/*", "https://vote.breaktudoawards.com/*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://blinksunited.com/*", "https://*.blinksunited.com/*"],
      "js": ["bu-link.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["assets/heart.png", "assets/lightstick.png"]
}
