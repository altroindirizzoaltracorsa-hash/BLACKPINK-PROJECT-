{
  "manifest_version": 3,
  "name": "Blinks United — VMA Vote Counter",
  "version": "1.2.1",
  "description": "Counts the BLACKPINK & members votes you cast on the MTV VMA site and logs them to your blinksunited.com voting board.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "https://vote.mtv.com/*",
    "https://blinksunited.com/*",
    "https://*.blinksunited.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "BU Vote Counter" },
  "content_scripts": [
    {
      "matches": ["https://vote.mtv.com/*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://blinksunited.com/*", "https://*.blinksunited.com/*"],
      "js": ["bu-link.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/heart.png", "assets/lightstick.png"],
      "matches": ["https://vote.mtv.com/*"]
    }
  ]
}
